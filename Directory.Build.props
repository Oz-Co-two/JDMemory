<Project>
  <!--
    版番号の定義元（MOD とインストーラーで共通）。
    変える時は manifest.json の "version" と CHANGELOG.md の先頭の見出しも同じにする
    （tools/make_release.ps1 が食い違いを見つけたら止まる）。
  -->
  <PropertyGroup>
    <Version>0.1.1</Version>
    <Authors>Oz-Co2</Authors>
    <Copyright>Copyright (C) 2026 Oz-Co2</Copyright>
  </PropertyGroup>
</Project>
